{
  "name": "@playground/compare-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "build:cf:dev": "opennextjs-cloudflare build --env dev",
    "build:cf:local": "pnpm db:migrate:local && opennextjs-cloudflare build",
    "build:cf:local:dev": "pnpm db:migrate:local:dev && opennextjs-cloudflare build --env dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "deploy": "pnpm run db:migrate:remote && pnpm run build:cf && opennextjs-cloudflare deploy",
    "deploy:dev": "pnpm run db:migrate:remote:dev && pnpm run build:cf:dev && opennextjs-cloudflare deploy --env dev",
    "upload": "pnpm run build:cf && opennextjs-cloudflare upload",
    "preview": "pnpm run build:cf:local && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply compare-next-db --local",
    "db:migrate:local:dev": "wrangler d1 migrations apply compare-next-db-dev --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply compare-next-db --remote",
    "db:migrate:remote:dev": "wrangler d1 migrations apply compare-next-db-dev --remote --env dev",
    "db:seed:local": "wrangler d1 execute compare-next-db --local --file ./seed/gpu.sql",
    "db:seed:remote": "wrangler d1 execute compare-next-db --remote --file ./seed/gpu.sql",
    "db:setup:local": "pnpm db:migrate:local && pnpm db:seed:local"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "@tanstack/react-query": "5.90.5",
    "next": "16.2.6",
    "react": "^19.1.7",
    "react-dom": "^19.1.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sass": "1.101.0",
    "typescript": "^5.7.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.108.0"
  }
}
